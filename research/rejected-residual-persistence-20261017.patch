+ // Residual persistence is estimated exclusively from already observed prices.
+ const residuals=points.map(p=>p.y-selected.predict(p.t));
+ let cross=0,square=0;
+ for(let i=1;i<residuals.length;i++){
+  if(points[i].t-points[i-1].t!==1)continue;
+  cross+=residuals[i]*residuals[i-1];square+=residuals[i-1]**2;
+ }
+ const persistence=square>1e-20?Math.max(0,Math.min(1,cross/square)):1;
